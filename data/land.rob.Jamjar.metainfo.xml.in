<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Jamjar</name>
  <summary>Jellyfin music for GNOME and Phosh</summary>

  <description>
    <p>
      Jamjar is a native GTK4 music client for self-hosted Jellyfin servers.
      It runs adaptively on GNOME desktops and Phosh-based Linux phones, with
      Quick Connect and password authentication, library browsing, queue
      management, MPRIS2 integration and gapless playback.
    </p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <content_rating type="oars-1.1" />

  <url type="homepage">https://codeberg.org/robland/jamjar</url>
  <url type="bugtracker">https://codeberg.org/robland/jamjar/issues</url>
  <url type="vcs-browser">https://codeberg.org/robland/jamjar</url>

  <branding>
    <color type="primary" scheme_preference="light">#f5b76a</color>
    <color type="primary" scheme_preference="dark">#7a3a1d</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Album view</caption>
      <image>https://codeberg.org/robland/jamjar/raw/branch/main/data/screenshots/album-page.png</image>
    </screenshot>
    <screenshot>
      <caption>Home page with Recently Added</caption>
      <image>https://codeberg.org/robland/jamjar/raw/branch/main/data/screenshots/home-page.png</image>
    </screenshot>
  </screenshots>

  <developer id="land.rob">
    <name>Rob Daniel</name>
  </developer>

  <releases>
    <release version="0.1.0" date="2026-04-25">
      <description>
        <p>Initial scaffold release.</p>
      </description>
    </release>
  </releases>
</component>
