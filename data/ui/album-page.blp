using Gtk 4.0;
using Adw 1;

template $JamjarAlbumPage: Adw.NavigationPage {
  title: _("Album");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 960;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;
          margin-bottom: 12;

          Adw.BreakpointBin {
            width-request: 280;
            height-request: 200;

            Adw.Breakpoint {
              condition ("max-width: 500sp")

              setters {
                header_box.orientation: vertical;
                cover_picture.halign: center;
                header_meta_box.halign: center;
                album_title_label.halign: center;
                album_title_label.xalign: 0.5;
                album_title_label.justify: center;
                album_artist_label.halign: center;
                album_artist_label.xalign: 0.5;
                album_artist_label.justify: center;
                album_meta_label.halign: center;
                album_meta_label.xalign: 0.5;
                header_actions_box.halign: center;
              }
            }

            Box header_box {
              orientation: horizontal;
              spacing: 18;

              Picture cover_picture {
                width-request: 200;
                height-request: 200;
                content-fit: cover;

                accessibility {
                  label: _("Album cover");
                }

                styles ["cover"]
              }

              Box header_meta_box {
                orientation: vertical;
                spacing: 6;
                hexpand: true;
                valign: center;

                Label album_title_label {
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;

                  styles ["title-1"]
                }

                Label album_artist_label {
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;

                  styles ["dim-label"]
                }

                Label album_meta_label {
                  xalign: 0;

                  styles ["caption", "dim-label"]
                }

                Box header_actions_box {
                  orientation: horizontal;
                  spacing: 6;
                  margin-top: 6;

                  Button play_button {
                    label: _("Play");

                    styles ["suggested-action", "pill"]
                  }

                  Button shuffle_button {
                    label: _("Shuffle");

                    styles ["pill"]
                  }

                  ToggleButton favorite_button {
                    icon-name: "heart-outline-symbolic";
                    tooltip-text: _("Favorite");
                  }
                }
              }
            }
          }

          Spinner tracks_spinner {
            spinning: true;
            halign: center;
            margin-top: 24;
            margin-bottom: 24;
            width-request: 32;
            height-request: 32;
          }

          ListBox tracks_list {
            visible: false;
            styles ["boxed-list"]
            selection-mode: none;
          }
        };
      };
    };
  };
}
