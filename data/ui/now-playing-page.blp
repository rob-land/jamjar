using Gtk 4.0;
using Adw 1;

template $JamjarNowPlayingPage: Adw.NavigationPage {
  title: _("Now Playing");
  tag: "now-playing";

  styles ["now-playing-page"]

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button sidebar_toggle {
        icon-name: "sidebar-show-symbolic";
        tooltip-text: _("Toggle Sidebar");
        styles ["flat"]
      }

      [end]
      Button now_playing_search {
        icon-name: "system-search-symbolic";
        action-name: "app.search";
        tooltip-text: _("Search");
        styles ["flat", "circular"]
      }

      [end]
      ToggleButton favorite_button {
        icon-name: "heart-outline-symbolic";
        tooltip-text: _("Favorite");
        sensitive: false;
        styles ["flat", "circular"]
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 720;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-start: 12;
          margin-end: 12;
          margin-top: 18;
          margin-bottom: 18;
          valign: center;

          Adw.Clamp {
            maximum-size: 480;
            tightening-threshold: 360;

            Box {
              orientation: vertical;
              spacing: 6;
              hexpand: true;

              Adw.Carousel now_playing_carousel {
                hexpand: true;

                Picture full_cover {
                  content-fit: cover;
                  width-request: 272;
                  height-request: 272;

                  accessibility {
                    label: _("Album cover");
                  }

                  styles ["cover"]
                }

                ScrolledWindow {
                  hscrollbar-policy: never;

                  child: Box lyrics_box {
                    orientation: vertical;
                    spacing: 0;
                    margin-start: 12;
                    margin-end: 12;
                    margin-top: 12;
                    margin-bottom: 12;
                    valign: start;
                  };
                }

                ScrolledWindow {
                  hscrollbar-policy: never;

                child: Box {
                  orientation: vertical;
                  spacing: 8;
                  margin-start: 8;
                  margin-end: 8;
                  margin-top: 8;
                  margin-bottom: 8;

                  Label {
                    label: _("Up Next");
                    xalign: 0;
                    styles ["heading"]
                  }

                  Label queue_empty_label {
                    label: _("The queue is empty");
                    wrap: true;
                    xalign: 0.5;
                    vexpand: true;
                    valign: center;
                    styles ["dim-label"]
                  }

                  ListBox now_playing_queue_list {
                    visible: false;
                    selection-mode: none;
                    styles ["boxed-list"]
                  }
                };
              }
            }

              Adw.CarouselIndicatorDots {
                carousel: now_playing_carousel;
                halign: center;
              }
            }
          }

          Box {
            orientation: vertical;
            spacing: 4;

            Label np_title {
              ellipsize: end;
              xalign: 0.5;
              styles ["title-1"]
            }

            Label np_artist {
              ellipsize: end;
              xalign: 0.5;
              styles ["title-3", "dim-label"]
            }

            Label np_album {
              ellipsize: end;
              xalign: 0.5;
              styles ["caption", "dim-label"]
            }
          }

          Box {
            orientation: horizontal;
            spacing: 8;
            valign: center;

            Label np_position {
              label: "0:00";
              width-chars: 5;
              styles ["numeric", "caption", "dim-label"]
            }

            Scale np_progress {
              orientation: horizontal;
              draw-value: false;
              hexpand: true;

              accessibility {
                label: _("Playback position");
              }

              adjustment: Adjustment {
                lower: 0;
                upper: 1;
                step-increment: 1;
                page-increment: 5;
              };
            }

            Label np_duration {
              label: "0:00";
              width-chars: 5;
              styles ["numeric", "caption", "dim-label"]
            }
          }

          Box {
            orientation: horizontal;
            spacing: 12;
            halign: center;

            ToggleButton np_shuffle {
              icon-name: "media-playlist-shuffle-symbolic";
              tooltip-text: _("Shuffle");
              styles ["circular", "flat"]
            }

            Button {
              icon-name: "media-skip-backward-symbolic";
              action-name: "app.previous";
              tooltip-text: _("Previous");
              styles ["circular", "flat"]
            }

            Button np_play {
              icon-name: "media-playback-start-symbolic";
              action-name: "app.toggle";
              tooltip-text: _("Play / Pause");
              width-request: 56;
              height-request: 56;
              styles ["suggested-action", "pill"]
            }

            Button {
              icon-name: "media-skip-forward-symbolic";
              action-name: "app.next";
              tooltip-text: _("Next");
              styles ["circular", "flat"]
            }

            Button np_repeat {
              icon-name: "media-playlist-repeat-symbolic";
              tooltip-text: _("Repeat");
              styles ["circular", "flat"]
            }
          }
        };
      };
    };
  };
}
