using Gtk 4.0;
using Adw 1;

template $JamjarLibraryPage: Adw.NavigationPage {
  title: _("Library");
  tag: "library";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button sidebar_toggle {
        icon-name: "sidebar-show-symbolic";
        tooltip-text: _("Toggle Sidebar");
      }

      title-widget: Adw.ViewSwitcher switcher {
        policy: narrow;
        stack: stack;
      };

      [end]
      Button library_search {
        icon-name: "system-search-symbolic";
        action-name: "app.search";
        tooltip-text: _("Search");
      }

      [end]
      Button refresh_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Refresh library");
        styles ["flat"]
      }

      [end]
      MenuButton filter_button {
        icon-name: "view-filter-symbolic";
        tooltip-text: _("Filter");
        styles ["flat"]
      }

      [end]
      MenuButton sort_button {
        icon-name: "view-sort-ascending-symbolic";
        tooltip-text: _("Sort");
        styles ["flat"]
      }

      [end]
      MenuButton letter_button {
        label: "A-Z";
        tooltip-text: _("Jump to letter");
        styles ["flat"]
      }
    }

    content: Adw.ViewStack stack {
      vexpand: true;

      Adw.ViewStackPage {
        name: "albums";
        title: _("Albums");
        icon-name: "media-optical-cd-audio-symbolic";

        child: Stack albums_stack {
          transition-type: crossfade;

          StackPage {
            name: "list";
            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: GridView albums_grid {
                single-click-activate: true;
                min-columns: 2;
                max-columns: 8;

                styles ["album-tile"]
              };
            };
          }

          StackPage {
            name: "empty";
            child: Adw.StatusPage {
              icon-name: "media-optical-cd-audio-symbolic";
              title: _("No Albums");
              description: _("Nothing here matches the current filter.");
            };
          }
        };
      }

      Adw.ViewStackPage {
        name: "artists";
        title: _("Artists");
        icon-name: "system-users-symbolic";

        child: Stack artists_stack {
          transition-type: crossfade;

          StackPage {
            name: "list";
            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: GridView artists_grid {
                single-click-activate: true;
                min-columns: 2;
                max-columns: 8;
              };
            };
          }

          StackPage {
            name: "empty";
            child: Adw.StatusPage {
              icon-name: "system-users-symbolic";
              title: _("No Artists");
              description: _("Nothing here matches the current filter.");
            };
          }
        };
      }

      Adw.ViewStackPage {
        name: "songs";
        title: _("Songs");
        icon-name: "audio-x-generic-symbolic";

        child: Stack songs_stack {
          transition-type: crossfade;

          StackPage {
            name: "list";
            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: ListView songs_list {
                single-click-activate: true;
              };
            };
          }

          StackPage {
            name: "empty";
            child: Adw.StatusPage {
              icon-name: "audio-x-generic-symbolic";
              title: _("No Songs");
              description: _("Nothing here matches the current filter.");
            };
          }
        };
      }

      Adw.ViewStackPage {
        name: "playlists";
        title: _("Playlists");
        icon-name: "view-list-symbolic";

        child: Stack playlists_stack {
          transition-type: crossfade;

          StackPage {
            name: "list";
            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: ListBox playlists_list {
                styles ["boxed-list"]
                selection-mode: none;
              };
            };
          }

          StackPage {
            name: "empty";
            child: Adw.StatusPage {
              icon-name: "view-list-symbolic";
              title: _("No Playlists");
              description: _("Create one on your Jellyfin server to see it here.");
            };
          }
        };
      }
    };
  };
}
