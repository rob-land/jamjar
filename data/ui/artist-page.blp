using Gtk 4.0;
using Adw 1;

template $JamjarArtistPage: Adw.NavigationPage {
  title: _("Artist");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 960;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;
          margin-bottom: 12;

          Adw.BreakpointBin {
            width-request: 280;
            height-request: 160;

            Adw.Breakpoint {
              condition ("max-width: 500sp")

              setters {
                artist_header_box.orientation: vertical;
                artist_image.halign: center;
                artist_meta_box.halign: center;
                artist_name_label.halign: center;
                artist_name_label.xalign: 0.5;
                artist_name_label.justify: center;
                artist_meta_label.halign: center;
                artist_meta_label.xalign: 0.5;
                artist_actions_box.halign: center;
              }
            }

            Box artist_header_box {
              orientation: horizontal;
              spacing: 18;

              Picture artist_image {
                width-request: 160;
                height-request: 160;
                content-fit: cover;

                accessibility {
                  label: _("Artist photo");
                }

                styles ["cover"]
              }

              Box artist_meta_box {
                orientation: vertical;
                spacing: 6;
                hexpand: true;
                valign: center;

                Label artist_name_label {
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;

                  styles ["title-1"]
                }

                Label artist_meta_label {
                  xalign: 0;

                  styles ["caption", "dim-label"]
                }

                Box artist_actions_box {
                  orientation: horizontal;
                  spacing: 6;
                  margin-top: 6;

                  Button artist_radio_button {
                    label: _("Start Radio");
                    styles ["pill", "suggested-action"]
                  }

                  ToggleButton favorite_button {
                    icon-name: "heart-outline-symbolic";
                    tooltip-text: _("Favorite");
                  }
                }
              }
            }
          }

          Box top_tracks_section {
            orientation: vertical;
            spacing: 6;
            margin-bottom: 12;
            // Shown only when the server reports play counts for this
            // artist — an empty "Top Tracks" heading is just noise.
            visible: false;

            Label {
              label: _("Top Tracks");
              xalign: 0;

              styles ["heading"]
            }

            ListBox top_tracks_list {
              selection-mode: none;

              styles ["boxed-list"]
            }
          }

          Label {
            label: _("Albums");
            xalign: 0;

            styles ["heading"]
          }

          Spinner albums_spinner {
            spinning: true;
            halign: center;
            margin-top: 24;
            margin-bottom: 24;
            width-request: 32;
            height-request: 32;
          }

          GridView artist_albums_grid {
            visible: false;
            min-columns: 2;
            max-columns: 8;
            single-click-activate: true;
          }

          Box similar_section {
            orientation: vertical;
            spacing: 6;
            margin-top: 12;
            // Revealed once the server returns something similar.
            visible: false;

            Label {
              label: _("Similar Artists");
              xalign: 0;

              styles ["heading"]
            }

            ScrolledWindow {
              vscrollbar-policy: never;
              propagate-natural-height: true;

              child: Box similar_row {
                orientation: horizontal;
                spacing: 12;
              };
            }
          }

        };
      };
    };
  };
}
